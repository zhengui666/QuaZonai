# Native same-origin deployment. Serve ONLY the immutable Vite dist directory.
# PUBLIC_URL in the Rust service must exactly equal this public HTTPS origin.
# Reference: https://caddyserver.com/docs/caddyfile/patterns#single-page-apps-spas
{$QUAZONAI_WEB_ADDRESS:localhost} {
	@backend path /api /api/* /health /health/*
	handle @backend {
		# The HTTP upstream retains the original Host, Origin, status and cookies.
		# Caddy already streams text/event-stream immediately. Do not buffer,
		# rewrite Origin, enable CORS, or retry non-idempotent requests here.
		reverse_proxy 127.0.0.1:8080
	}
	handle {
		root * {$QUAZONAI_WEB_ROOT:/opt/quazonai/apps/web/dist}
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@fresh not path /assets/*
		header @fresh Cache-Control "no-cache"
		header {
			Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self'; img-src 'self' data:; font-src 'self' data:; worker-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
			X-Content-Type-Options "nosniff"
			X-Frame-Options "DENY"
			Referrer-Policy "no-referrer"
			Permissions-Policy "camera=(), microphone=(), geolocation=()"
		}
		# No directory browsing, API-to-HTML fallback, source-map serving or CDN.
		file_server
	}
}
