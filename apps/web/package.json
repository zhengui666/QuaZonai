{
  "name": "@quazonai/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "generate": "openapi-typescript ../../contracts/generated/api-v2.openapi.json -o src/generated/api.d.ts && node scripts/generate-validators.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run generate && npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:native": "node scripts/native-browser.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "6.3.1",
    "@microsoft/fetch-event-source": "2.0.1",
    "@tanstack/react-query": "^5.90.0",
    "antd": "6.5.2",
    "openapi-fetch": "^0.14.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "openapi-typescript": "^7.10.1",
    "otpauth": "9.5.1",
    "typescript": "5.9.3",
    "vite": "7.3.3",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "4.1.7"
  }
}
