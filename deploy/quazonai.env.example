# Copy outside the repository to /etc/quazonai/quazonai.env (root:quazonai, 0640).
# The quazonai USER manager must be able to read it; do not share it with Caddy.
# The native user manager supplies XDG_RUNTIME_DIR. Do not point it at another UID.
# This is systemd EnvironmentFile syntax: no `export` or shell interpolation.
# Fill DATABASE_URL locally with the NON-OWNER application identity. Never use
# the migration/DDL identity here or paste a real credential into a task or log.
DATABASE_URL=
STATE_DIR=/var/lib/quazonai/state
BIND=127.0.0.1:8080
PUBLIC_URL=http://localhost:8081
DEVELOPMENT_HTTP=true
WORKER_PARALLELISM=2
RUNTIME_TARGETS=[]
DOWNSTREAM_TARGETS=[]

# Run the API and Worker as the same OS user who owns the installed Codex.
# The process PATH, HOME and native CODEX_HOME are used automatically.
# Authenticate with `codex login` in that user's shell; QZ never copies auth.json.
# Worker inherits PUBLIC_URL above. An independently configured Worker may set
# MISSION_API_ORIGIN instead; both values, when set, must match exactly.
# MISSION_API_ORIGIN=http://localhost:8081
# Optional override for the private task workspace; default is STATE_DIR/missions.
# MISSION_WORKSPACES=/var/lib/quazonai/missions
