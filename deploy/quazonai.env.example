# Copy outside the repository to /etc/quazonai/quazonai.env (root-owned, 0600).
# This is systemd EnvironmentFile syntax: no `export` or shell interpolation.
# Fill DATABASE_URL locally with the NON-OWNER application identity. Never use
# the migration/DDL identity here or paste a real credential into a task or log.
DATABASE_URL=
STATE_DIR=/var/lib/quazonai/state
BIND=127.0.0.1:8080
PUBLIC_URL=https://quazonai.example.com
DEVELOPMENT_HTTP=false
WORKER_PARALLELISM=2
RUNTIME_TARGETS=[]
DOWNSTREAM_TARGETS=[]

# Configure all three only after preparing the native Codex deployment bindings
# and a private, existing Mission workspaces directory. Without these bindings,
# Worker process health does not mean native model research is available.
# CODEX_DEPLOYMENT=/etc/quazonai/codex-deployment.json
# MISSION_API_ORIGIN=https://quazonai.example.com
# MISSION_WORKSPACES=/var/lib/quazonai/missions
