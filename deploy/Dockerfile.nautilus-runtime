FROM python:3.14-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /workspace

COPY backend /workspace/backend
RUN python -m pip install --no-cache-dir -e '/workspace/backend[nautilus-runtime]'

RUN useradd --create-home --uid 10001 nautilus \
    && mkdir -p /var/lib/nautilus/catalogs \
    && chown -R nautilus:nautilus /var/lib/nautilus

USER nautilus
EXPOSE 8011

CMD ["quazonai-nautilus-runtime"]
