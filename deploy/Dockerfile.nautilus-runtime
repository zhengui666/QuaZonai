FROM python:3.14-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    QUAZONAI_NAUTILUS_CATALOG_ROOT=/var/lib/quazonai-nautilus/catalogs

RUN groupadd --system quazonai-nautilus \
    && useradd --system --gid quazonai-nautilus --home-dir /home/quazonai-nautilus \
       --create-home quazonai-nautilus \
    && mkdir -p /workspace /var/lib/quazonai-nautilus/catalogs \
       /var/lib/nautilus/catalogs /var/lib/nautilus/sealed-catalogs \
       /var/lib/quazonai/plugins \
    && chown -R quazonai-nautilus:quazonai-nautilus \
       /workspace /var/lib/quazonai-nautilus /var/lib/nautilus /home/quazonai-nautilus

WORKDIR /workspace
COPY backend /workspace/backend
RUN python -m pip install --no-cache-dir '/workspace/backend[nautilus-runtime]'

USER quazonai-nautilus
EXPOSE 9010
VOLUME ["/var/lib/quazonai-nautilus/catalogs"]
ENTRYPOINT ["quazonai-nautilus-runtime"]
