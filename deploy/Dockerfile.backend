FROM python:3.14-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PATH=/opt/venv/bin:$PATH

RUN groupadd --system quazonai \
    && useradd --system --gid quazonai --home-dir /home/quazonai \
       --create-home --shell /usr/sbin/nologin quazonai \
    && apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install --yes --no-install-recommends \
       ca-certificates libpq5 \
    && rm -rf /var/lib/apt/lists/* \
    && python -m venv /opt/venv

WORKDIR /workspace
COPY backend/ /workspace/backend/
RUN /opt/venv/bin/python -m pip install --no-cache-dir "/workspace/backend[research,trading,mcp]"

RUN mkdir -p \
      /var/lib/quazonai/plugins \
      /var/lib/quazonai/catalog \
      /var/lib/quazonai/reports \
      /var/lib/quazonai/imports \
      /var/lib/quazonai/agent-artifacts \
    && chown -R quazonai:quazonai /var/lib/quazonai /workspace

WORKDIR /workspace/backend
USER quazonai
EXPOSE 8000
