FROM node:24-alpine AS frontend-builder

WORKDIR /workspace/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

FROM python:3.14-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PATH=/opt/venv/bin:$PATH \
    QUAZONAI_FRONTEND_DIST=/workspace/frontend-dist \
    CODEX_HOME=/home/quazonai/.codex

RUN groupadd --system quazonai \
    && useradd --system --gid quazonai --home-dir /home/quazonai \
       --create-home --shell /usr/sbin/nologin quazonai \
    && apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install --yes --no-install-recommends \
       ca-certificates git libpq5 \
    && rm -rf /var/lib/apt/lists/* \
    && python -m venv /opt/venv

WORKDIR /workspace
COPY backend/ /workspace/backend/
RUN /opt/venv/bin/python -m pip install --no-cache-dir "/workspace/backend[research,mcp,agent]"
COPY --from=frontend-builder /workspace/frontend/dist /workspace/frontend-dist

RUN mkdir -p \
      /var/lib/quazonai/plugins \
      /var/lib/quazonai/packages \
      /var/lib/quazonai/missions \
      /home/quazonai/.codex \
    && chown -R quazonai:quazonai /var/lib/quazonai /home/quazonai /workspace

WORKDIR /workspace/backend
USER quazonai
EXPOSE 8000
