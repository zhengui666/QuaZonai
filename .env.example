QF_ENV=development
QF_POSTGRES_DB=quantfoundry
QF_POSTGRES_USER=quantfoundry
QF_POSTGRES_PASSWORD=quantfoundry-local
QF_DATABASE_URL=postgresql+psycopg://quantfoundry:quantfoundry-local@postgres:5432/quantfoundry
QF_ALEMBIC_URL=postgresql+psycopg://quantfoundry:quantfoundry-local@postgres:5432/quantfoundry
QF_MASTER_KEY=
QF_PLUGIN_ROOT=/var/lib/quantfoundry/plugins
QF_CATALOG_ROOT=/var/lib/quantfoundry/catalog
QF_REPORT_ROOT=/var/lib/quantfoundry/reports
QF_IMPORT_ROOT=/var/lib/quantfoundry/imports
QF_AGENT_ARTIFACT_ROOT=/var/lib/quantfoundry/agent-artifacts
QF_MAX_PARQUET_UPLOAD_BYTES=10737418240
QF_MAX_PLUGIN_WHEEL_BYTES=268435456
QF_PLUGIN_VALIDATION_TIMEOUT_SECONDS=180
QF_BUNDLE_BUILD_TIMEOUT_SECONDS=600
QF_PLUGIN_JOB_TIMEOUT_SECONDS=900
QF_INTEGRATION_PREFLIGHT_TIMEOUT_SECONDS=120
QF_STRATEGY_VALIDATION_TIMEOUT_SECONDS=60
QF_PARQUET_IMPORT_TIMEOUT_SECONDS=3600
QF_BACKTEST_TIMEOUT_SECONDS=3600
QF_RESEARCH_JOB_TIMEOUT_SECONDS=43200
QF_JOB_POLL_SECONDS=1.0
QF_JOB_LEASE_SECONDS=60
QF_SUPERVISOR_POLL_SECONDS=1.0
QF_HTTP_PORT=8000
