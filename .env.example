QUAZONAI_ENV=development
QUAZONAI_POSTGRES_DB=quazonai
QUAZONAI_POSTGRES_USER=quazonai
QUAZONAI_POSTGRES_PASSWORD=quazonai-local
QUAZONAI_DATABASE_URL=postgresql+psycopg://quazonai:quazonai-local@postgres:5432/quazonai
QUAZONAI_ALEMBIC_URL=postgresql+psycopg://quazonai:quazonai-local@postgres:5432/quazonai
QUAZONAI_MASTER_KEY=
QUAZONAI_PLUGIN_ROOT=/var/lib/quazonai/plugins
QUAZONAI_PACKAGE_ROOT=/var/lib/quazonai/packages
QUAZONAI_MISSION_ROOT=/var/lib/quazonai/missions
QUAZONAI_HTTP_PORT=8000
