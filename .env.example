# Allowed values: development, test, production.
QUAZONAI_ENV=development
QUAZONAI_POSTGRES_DB=quazonai
QUAZONAI_POSTGRES_USER=quazonai
QUAZONAI_POSTGRES_PASSWORD=quazonai-local
QUAZONAI_DATABASE_URL=postgresql+psycopg://quazonai:quazonai-local@postgres:5432/quazonai
QUAZONAI_ALEMBIC_URL=postgresql+psycopg://quazonai:quazonai-local@postgres:5432/quazonai
QUAZONAI_MASTER_KEY=

# Optional single-operator authentication. false preserves direct access.
# When enabled, the TOTP/cookie-key/API-token/public-origin values below are required. TOTP is
# compatible with Google Authenticator. COOKIE_KEY must differ from MASTER_KEY;
# API_TOKEN must be a 32..4096-character RFC 6750 b64token. Browser origins
# are canonicalized; enabled production authentication requires HTTPS/Secure cookies.
QUAZONAI_AUTH_ENABLED=false
QUAZONAI_AUTH_TOTP_SECRET=
QUAZONAI_AUTH_COOKIE_KEY=
QUAZONAI_API_TOKEN=
QUAZONAI_AUTH_PUBLIC_ORIGIN=
QUAZONAI_AUTH_SESSION_TTL_SECONDS=43200
QUAZONAI_AUTH_TRUSTED_BROWSER_TTL_DAYS=30
# Optional: only proxy peer IPs/CIDRs actually seen by the API/container may
# supply X-Forwarded-For. Keep this narrow; do not use /0. Blank means ignore
# forwarding headers. `127.0.0.1/32` is only for direct/host-network peers;
# Compose often sees a Docker bridge/gateway instead. Keep Uvicorn proxy-header
# rewriting disabled so QuaZonai can verify the direct peer.
QUAZONAI_AUTH_TRUSTED_PROXY_CIDRS=

QUAZONAI_PLUGIN_ROOT=/var/lib/quazonai/plugins
QUAZONAI_PACKAGE_ROOT=/var/lib/quazonai/packages
QUAZONAI_MISSION_ROOT=/var/lib/quazonai/missions
QUAZONAI_HTTP_PORT=8000

# Independently deployed canonical NautilusTrader runtime.
# The service token authenticates QuaZonai to the quant runtime; it is not a
# broker/exchange credential. Production requires an HTTPS URL and a token.
# The API and finite worker use this connection for governed catalog operations,
# Research/Sealed/Portfolio runs and Candidate conformance. Mission Codex children
# receive blank values for every variable below.
QUAZONAI_NAUTILUS_RUNTIME_URL=http://nautilus-runtime-proxy:8011
QUAZONAI_NAUTILUS_RUNTIME_TOKEN=
QUAZONAI_NAUTILUS_SEALED_RUNTIME_URL=http://nautilus-runtime-proxy:8012
QUAZONAI_NAUTILUS_SEALED_RUNTIME_TOKEN=
QUAZONAI_NAUTILUS_VERSION=1.231.0
QUAZONAI_NAUTILUS_CONTRACT_VERSION=2
QUAZONAI_NAUTILUS_RUNTIME_TIMEOUT_SECONDS=120
QUAZONAI_NAUTILUS_RUNTIME_POLL_SECONDS=0.25
QUAZONAI_NAUTILUS_RUNTIME_VERIFY_TLS=true
